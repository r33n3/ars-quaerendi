{
  "type": "object",
  "properties": {
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "uncertainty": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "limitations",
          "open_questions"
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "enum": [
        "illustrative",
        "operational"
      ]
    },
    "tested_scope": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "population": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "coverage": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "domain": {
            "enum": [
              "real_world",
              "software",
              "simulation",
              "conceptual",
              "unknown"
            ]
          }
        },
        "required": [
          "population",
          "coverage",
          "conditions",
          "domain"
        ],
        "additionalProperties": false
      }
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_context": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "experiment_state": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pending_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "resource_snapshot": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "runtime",
            "unknown"
          ]
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "source",
        "metrics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "metrics": {
                "additionalProperties": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "runtime"
              }
            }
          },
          "then": {
            "required": [
              "captured_at",
              "source_ref"
            ]
          }
        }
      ]
    },
    "recovery_status": {
      "enum": [
        "unverified",
        "verified",
        "failed"
      ]
    },
    "recovery_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "evidence_ids",
    "evidence_refs",
    "evidence_hashes",
    "uncertainty",
    "schema_version",
    "record_kind",
    "tested_scope",
    "checkpoint_id",
    "purpose_ref",
    "goal_ref",
    "unknowns",
    "contradictions",
    "next_action",
    "authority_context",
    "experiment_state",
    "pending_actions",
    "resource_snapshot",
    "recovery_status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "recovery_status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "recovery_evidence_ids"
        ]
      }
    }
  ]
}
