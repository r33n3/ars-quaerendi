{
  "type": "object",
  "properties": {
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_hashes": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "uncertainty": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "limitations",
          "open_questions"
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "enum": [
        "illustrative",
        "operational"
      ]
    },
    "adaptation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "unverified",
            "documented",
            "tested"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "method",
        "conditions",
        "status",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "documented",
                  "tested"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "environment_delta": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "reported",
            "observed",
            "hypothesis",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "status",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "reported",
                  "observed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "proposed",
              "tested",
              "rejected",
              "retained",
              "inconclusive"
            ]
          },
          "predictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "comparison": {
            "type": "object",
            "properties": {
              "baseline_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "variant_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "criteria_met": {
                "type": "boolean"
              },
              "outcome": {
                "enum": [
                  "improvement",
                  "recovery",
                  "regression",
                  "no_change",
                  "inconclusive"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "regressions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "baseline_evidence_ids",
              "variant_evidence_ids",
              "conditions",
              "criteria_met",
              "outcome",
              "summary",
              "regressions"
            ],
            "additionalProperties": false
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "method",
          "mechanism",
          "status",
          "predictions",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "tested",
                    "retained"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "comparison"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "proposed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "comparison"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "rejected"
                }
              }
            },
            "then": {
              "required": [
                "disposition_reason"
              ]
            }
          }
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "selection": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "baseline",
            "variant",
            "hold",
            "stop",
            "inconclusive"
          ]
        },
        "selected_variant_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retained_alternative_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "decision",
        "selected_variant_id",
        "rationale",
        "retained_alternative_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "variant"
              }
            }
          },
          "then": {
            "properties": {
              "selected_variant_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "selected_variant_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "tested_scope": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "population": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "coverage": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "domain": {
            "enum": [
              "real_world",
              "software",
              "simulation",
              "conceptual",
              "unknown"
            ]
          }
        },
        "required": [
          "population",
          "coverage",
          "conditions",
          "domain"
        ],
        "additionalProperties": false
      }
    },
    "decision_domain": {
      "enum": [
        "real_world",
        "software",
        "simulation",
        "conceptual",
        "unknown"
      ]
    },
    "authority_context": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "resource_limit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "resource_cost": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "retest_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "evidence_ids",
    "evidence_refs",
    "evidence_hashes",
    "uncertainty",
    "schema_version",
    "record_kind",
    "adaptation_id",
    "purpose_ref",
    "claim_id",
    "baseline",
    "environment_delta",
    "variants",
    "acceptance_criteria",
    "selection",
    "tested_scope",
    "decision_domain",
    "authority_context",
    "resource_limit",
    "resource_cost",
    "retest_triggers"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptation comparison record"
}
