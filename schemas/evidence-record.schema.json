{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "enum": [
        "illustrative",
        "operational"
      ]
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "direct",
            "document",
            "peer",
            "inference",
            "independent_reproduction",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "independence_basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "origin",
        "source",
        "method"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "enum": [
        "supports",
        "contradicts",
        "qualifies",
        "neutral",
        "undetermined"
      ]
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "limitations",
        "open_questions"
      ],
      "additionalProperties": false
    },
    "tested_scope": {
      "type": "object",
      "properties": {
        "population": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "population",
        "coverage",
        "conditions"
      ],
      "additionalProperties": false
    },
    "legacy_status": {
      "enum": [
        "D",
        "O",
        "R",
        "H",
        "U",
        "X"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "evidence_id",
    "claim_id",
    "claim",
    "observation",
    "provenance",
    "relationship",
    "uncertainty",
    "tested_scope",
    "legacy_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "legacy_status": {
            "const": "R"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "origin": {
                "const": "independent_reproduction"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "legacy_status": {
            "const": "O"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "origin": {
                "enum": [
                  "direct",
                  "independent_reproduction"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "origin": {
                "const": "independent_reproduction"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "independence_basis",
              "artifact_ids"
            ],
            "properties": {
              "artifact_ids": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
